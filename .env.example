# Telegram API (https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash
# User session string (generate with: python generate_session.py) - used to LISTEN to channels
SESSION_STRING=
# Bot token from @BotFather - used for admin commands and POSTING
BOT_TOKEN=123456:ABC...
# Only this Telegram user ID can control the bot
ADMIN_ID=123456789

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key

# AI provider: gemini or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Render web service port (health check)
PORT=10000
